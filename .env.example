# ==============================================================================
# RAG Document Q&A Assistant - Environment Configuration
# ==============================================================================

# LLM & Embedding API Keys
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Default LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Default Embedding Provider: "gemini" or "huggingface"
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/embedding-001
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Ingestion Paths
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
COLLECTION_NAME=document_qa

# Default Chunking & Retrieval Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
