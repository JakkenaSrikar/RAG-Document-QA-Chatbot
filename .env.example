# ==============================================================================
# RAG Document Q&A Assistant - Environment Configuration
# ==============================================================================

# LLM & Embedding API Keys (Leave blank in .env.example - set real keys in .env only!)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Default LLM Provider: "groq" or "gemini"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Default Embedding Provider: "huggingface" (local CPU) or "gemini"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=models/text-embedding-004
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Ingestion Paths
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
COLLECTION_NAME=document_qa

# Default Chunking & Retrieval Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
